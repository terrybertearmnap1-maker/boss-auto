#!/bin/sh
# pre-commit：阻止把个人资料/二进制文档提交进仓库
# 启用：git config core.hooksPath .githooks

bad=0
files=$(git diff --cached --name-only --diff-filter=ACM)
for f in $files; do
  case "$f" in
    private/*|resume/*|*.pdf|*.docx|*.doc|*.db|*.sqlite3|.env|.env.*)
      echo "✗ 拒绝提交：$f（个人资料或运行期文件）"
      bad=1
      ;;
  esac
done

if [ $bad -eq 1 ]; then
  echo ""
  echo "提示：这些路径应保留在本地，已由 .gitignore 排除。"
  exit 1
fi
exit 0